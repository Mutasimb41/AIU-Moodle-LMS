  "id": "DEMO",
  "documents": [
    {
      "id": "INF",
      "guid": "5d2204d5-453f-430a-b55d-9dd5e3da5246",
      "name": "Information",
      "lastId": 30,
      "createdOn": "2018-08-19T16:59:43.883Z",
