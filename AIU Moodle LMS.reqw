                  "guid": "86c3da79-58a6-4278-acbe-3a57b94f40f2",
                  "heading": "Dialogs",
                  "text": "<p>UI dialogs opened from UI actions</p>",
                  "type": "MOD",
                  "links": {
                    "implementation": [
                      "SRS-199"
                    ]
                  }
                },
                {
                  "id": "11",
                  "guid": "9a54b3e8-8993-41df-93f1-28ddcd18b765",
                  "heading": "Commands",
                  "text": "<p>Commands called from the CLI</p>",
                  "type": "MOD",
                  "links": {
                    "usage": [
                      "ARCH-12",
                      "ARCH-14"
                    ]
                  }
                },
                {
                  "id": "14",
                  "guid": "173807e0-890f-4ab4-ad8d-59e366718ee4",
                  "heading": "Export",
                  "text": "<p>Exporters of project data to supported external file formats</p>",
                  "type": "MOD",
