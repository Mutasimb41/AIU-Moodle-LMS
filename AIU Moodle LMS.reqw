      },
      "templateColumns": {
        "283578a7-4cef-47a9-b7ef-68d9f81038a7": {
          "label": "Downstream Traceability",
          "template": "{{#if (eval type \"==\" \"ACT\")}}\n{{#if (hasInlinks \"mitigation\")}}\n{{#eachInlinkWith type=\"mitigation\"}}\n <p>&#x25C2; {{#hyperlink}}{{docObjId}}{{/hyperlink}}: {{shortDescription  maxLength=80}}</p>\n{{#if (hasInlinks \"verification\")}}\n{{#eachInlinkWith type=\"verification\"}}\n  <p style=\"margin-left:15px\">&#x25C2; {{#hyperlink}}{{docObjId}}{{/hyperlink}}: {{shortDescription  maxLength=80}}</p>\n{{/eachInlinkWith}}\n{{else}}\n  <p style=\"margin-left:15px\"><em>Missing verification links!</em></div>\n{{/if}}\n{{/eachInlinkWith}}\n{{else}}\n  <p><em>Missing mitigation links!</em></div>\n{{/if}}\n{{/if}}"
        },
        "74b9b882-3a3e-4f19-891e-c993faa3a574": {
          "label": "RPN",
          "template": "{{#if (eval (eval type \"==\" \"CAUSE\") \"||\" (eval type \"==\" \"ACT\"))}}\n{{var \"rpn\" (eval (eval detectability \"*\" probability) \"*\" severity)}}\n<p style=\"font-weight:bold; text-align:center; {{#if (eval (get \"rpn\") \">\" 100)}}background-color:lightsalmon;{{/if}}\">\n   {{get \"rpn\"}}\n</p>\n{{/if}}"
        }
      },
