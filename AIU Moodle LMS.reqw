        "Filter User Stories": {
          "columns": [
            {
              "columnId": "id",
              "width": 99
            },
            {
              "columnId": "description",
              "width": 288
            },
            {
              "templateColumnId": "dd7d52bc-d0a2-4bfe-99b2-c7daa90ea5a9",
              "width": 262
