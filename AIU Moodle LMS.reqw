  "dashboard": {
    "tabs": {
      "Default": {
        "widgets": {
          "NEEDS - Overview": {
            "options": {
              "h": 5,
              "locked": false,
              "w": 8,
              "x": 0,
              "y": 4
            },
            "template": "{{var \"numStories\" 0}}\n{{var \"numSatisfied\" 0}}\n\n<!-- Iterate all objects in the document 'NEEDS' and count number of stories. -->\n{{#withDocument \"NEEDS\"}}\n  {{#eachDocumentObject}}\n    {{#if (eval type \"==\" \"STORY\")}}\n      {{incr \"numStories\"}}\n      {{#if (hasInlinks \"satisfaction\")}}\n        {{incr \"numSatisfied\"}}\n      {{/if}}\n    {{/if}}\n  {{/eachDocumentObject}}\n{{/withDocument}}\n\n<!-- Count number of satistied and unsatistied stories in percent. -->\n{{var \"numNotSatisfied\" (eval (get \"numStories\") \"-\" (get \"numSatisfied\"))}}\n{{var \"percentSatisfied\" 1}}\n{{var \"percentNotSatisfied\" 0}}\n{{#if (eval (get \"numStories\") \">\" 0)}}\n  {{set \"percentSatisfied\" (eval (get \"numSatisfied\") \"/\" (get \"numStories\"))}}\n  {{set \"percentNotSatisfied\" (eval (get \"numNotSatisfied\") \"/\" (get \"numStories\"))}}\n{{/if}}\n{{var \"percentSatisfied100\" (round (eval (get \"percentSatisfied\") \"*\" \"100\"))}}\n{{var \"percentNotSatisfied100\" (round (eval (get \"percentNotSatisfied\") \"*\" \"100\"))}}\n\n<!-- HTML output section. -->\n\n<!-- Counters -->\n<div style=\"display: flex; flex-direction: row; flex-wrap: wrap;\">\n  <div style=\"flex: 1; min-width: 60px; padding: 4px; margin: 4px; position: relative; background-color: #f5f5f5; border: 1px solid #e3e3e3; border-radius: 4px; text-align: center; box-shadow: 3px 3px 3px grey;\">\n    <div style=\"font-size: 1.5rem\">\n      {{get \"numStories\"}}\n    </div>\n    <div style=\"white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 1rem;\">\n      user stories\n    </div>\n  </div>\n  <div style=\"flex: 1; min-width: 60px; padding: 4px; margin: 4px; position: relative; background-color: #f5f5f5; border: 1px solid #e3e3e3; border-radius: 4px; text-align: center; box-shadow: 3px 3px 3px grey;\">\n    <div style=\"font-size: 1.5rem\">\n      {{get \"percentSatisfied100\"}}%\n    </div> \n    <div style=\"white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 1rem;\">\n      satisfied\n    </div>\n  </div>\n</div>\n"
          },
          "NEEDS - User Needs by Status": {
            "options": {
              "h": 9,
              "locked": false,
              "w": 8,
              "x": 0,
              "y": 9
            },
            "template": "{{var \"numItems\" 0}}\n\n<!--\n  Create map to count attribute value occurance and init it to 0.\n  Chart will respect the order of the 'setElement' calls below.\n-->\n{{map \"counterMap\"}}\n{{setElement \"counterMap\" \"New\" 0}}\n{{setElement \"counterMap\" \"Planned\" 0}}\n{{setElement \"counterMap\" \"Implemented\" 0}}\n{{setElement \"counterMap\" \"Verified\" 0}}\n\n<!-- Create map where labels of attribute values will be stored. -->\n{{map \"labelMap\"}}\n{{setElement \"labelMap\" \"New\" \"New\"}}\n{{setElement \"labelMap\" \"Planned\" \"Planned\"}}\n{{setElement \"labelMap\" \"Implemented\" \"Implemented\"}}\n{{setElement \"labelMap\" \"Verified\" \"Verified\"}}\n\n<!--\n  Create theme map with color for every attribute value. Use any color syntax supported by CSS:\n    - color name: 'lightblue'\n    - hex RGB or RGBA: '#add8e6' or '#add8e6ff'\n    - decimal RGB or RGBA: 'rgb(173, 216, 230)' or 'rgba(173, 216, 230, 1.)'\n    - other syntaxes, see https://developer.mozilla.org/en-US/docs/Web/CSS/named-color\n-->\n{{map \"colorMap\"}}\n{{setElement \"colorMap\" \"New\" \"khaki\"}}\n{{setElement \"colorMap\" \"Planned\" \"sandybrown\"}}\n{{setElement \"colorMap\" \"Implemented\" \"lightblue\"}}\n{{setElement \"colorMap\" \"Verified\" \"lightgreen\"}}\n\n<!-- Iterate all objects in the document 'NEEDS' and count occurance of attribute value(s). -->\n{{#withDocument \"NEEDS\" tableView=\"Filter User Stories\"}}\n  {{#eachDocumentObject}}\n    {{incr \"numItems\"}}\n    {{#if [status]}}\n      {{#if (includes \"counterMap\" [status])}}\n        {{setElement \"counterMap\" [status] (eval (getElement \"counterMap\" [status]) \"+\" 1)}}\n      {{/if}}\n    {{/if}}\n  {{/eachDocumentObject}}\n{{/withDocument}}\n\n<!-- Find maximum value for to convert values into normalize range [0..1] in HTML output section. -->\n{{var \"maxValue\" 0}}\n{{#eachOfMap \"counterMap\"}}\n  {{#if (eval @value \">\" (get \"maxValue\"))}}\n    {{set \"maxValue\" @value}}\n  {{/if}}\n{{/eachOfMap}}\n\n<!-- Chart -->\n<div style=\"container-type: size; width: 100%; height: 100%; font-size: 0.9em;\">\n  <table class=\"charts-css show-primary-axis data-outside column data-spacing-4 show-labels\" style=\"min-width: 50px; height: 100%;\">\n    <thead>\n      <tr>\n        <th>Status</th>\n        <th>Count</th>\n      </tr>\n    </thead>\n    <tbody style=\"height: inherit;\">\n{{#eachOfMap \"counterMap\"}}\n      <tr>\n        <th style=\"text-overflow: ellipsis; overflow: hidden; white-space: nowrap;\">{{{getElement \"labelMap\" @key}}}</th>\n        <td style=\"--size: {{eval @value \"/\" (get \"maxValue\")}}; background: {{getElement \"colorMap\" @key}};\">\n          <span class=\"data\" style=\"white-space: nowrap;\">{{@value}}</span>\n          <span class=\"tooltip\">{{@value}} of {{get \"numItems\"}}</span>\n        </td>\n      </tr>\n{{/eachOfMap}}\n    </tbody>\n  </table>\n</div>"
          },
          "Project Description": {
            "options": {
              "h": 4,
              "locked": false,
              "w": 24,
              "x": 0,
              "y": 0
            },
            "template": "<p>\n  This <a href=\"https://www.reqview.com/doc/example-project/\">ReqView Example Project</a> \n  demonstrates how you can easily manage requirements in ReqView.\n  It describes basic functionality of a requirements management tool and consists of \n  the following documents: \n  <em>NEEDS</em> (top level needs as user stories), \n  <em>ASVS</em> (IS requirements using the OWASP ASVS standard), \n  <em>RISKS</em> (risks analysis using the FMEA method), \n  <em>SRS</em> (low-level SW requirements using the ISO 29148 standard), \n  <em>TESTS</em> (test cases), and \n  <em>ARCH</em> (SW packages).\n</p>"
          },
          "SRS - Overview": {
            "options": {
              "h": 5,
              "locked": false,
              "w": 8,
              "x": 8,
              "y": 4
            },
            "template": "{{var \"numRequirements\" 0}}\n{{var \"numVerified\" 0}}\n\n<!-- Iterate all objects in the document 'SRS' and count number of verified requirements. -->\n{{#withDocument \"SRS\"}}\n  {{#eachDocumentObject}}\n    {{#eachColumn}}\n      {{#if (eval (columnId) \"==\" \"type\")}}\n        {{#if (or (or (eval type \"==\" \"FR\") (eval type \"==\" \"INT\")) (eval type \"==\" \"NFR\"))}}\n          {{incr \"numRequirements\"}}\n          {{#if (hasInlinks \"verification\")}}\n            {{incr \"numVerified\"}}\n          {{/if}}\n        {{/if}}\n      {{/if}}\n    {{/eachColumn}}\n  {{/eachDocumentObject}}\n{{/withDocument}}\n\n<!-- Count number of verified and unverified requirements in percent. -->\n{{var \"numNotVerified\" (eval (get \"numRequirements\") \"-\" (get \"numVerified\"))}}\n{{var \"percentVerified\" 1}}\n{{var \"percentNotVerified\" 0}}\n{{#if (eval (get \"numRequirements\") \">\" 0)}}\n  {{set \"percentVerified\" (eval (get \"numVerified\") \"/\" (get \"numRequirements\"))}}\n  {{set \"percentNotVerified\" (eval (get \"numNotVerified\") \"/\" (get \"numRequirements\"))}}\n{{/if}}\n{{var \"percentVerified100\" (round (eval (get \"percentVerified\") \"*\" \"100\"))}}\n{{var \"percentNotVerified100\" (round (eval (get \"percentNotVerified\") \"*\" \"100\"))}}\n\n<!-- Counters -->\n<div style=\"display: flex; flex-direction: row; flex-wrap: wrap;\">\n  <div style=\"flex: 1; min-width: 60px; padding: 4px; margin: 4px; position: relative; background-color: #f5f5f5; border: 1px solid #e3e3e3; border-radius: 4px; text-align: center; box-shadow: 3px 3px 3px grey;\">\n    <div style=\"font-size: 1.5rem\">\n      {{get \"numRequirements\"}}\n    </div>\n    <div style=\"white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 1rem;\">\n      SW requirements\n    </div>\n  </div>\n  <div style=\"flex: 1; min-width: 60px; padding: 4px; margin: 4px; position: relative; background-color: #f5f5f5; border: 1px solid #e3e3e3; border-radius: 4px; text-align: center; box-shadow: 3px 3px 3px grey;\">\n    <div style=\"font-size: 1.5rem\">\n      {{get \"percentVerified100\"}}%\n    </div> \n    <div style=\"white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 1rem;\">\n      verified\n    </div>\n  </div>\n</div>\n"
          },
          "SRS - SW Requirements by Status": {
            "options": {
              "h": 9,
              "locked": false,
              "w": 8,
              "x": 8,
              "y": 9
            },
            "template": "{{var \"numItems\" 0}}\n\n<!--\n  Create map to count attribute value occurance and init it to 0.\n  Chart will respect the order of the 'setElement' calls below.\n-->\n{{map \"counterMap\"}}\n{{setElement \"counterMap\" \"Draft\" 0}}\n{{setElement \"counterMap\" \"Ready\" 0}}\n{{setElement \"counterMap\" \"Reviewed\" 0}}\n{{setElement \"counterMap\" \"Approved\" 0}}\n{{setElement \"counterMap\" \"Released\" 0}}\n\n<!-- Create map where labels of attribute values will be stored. -->\n{{map \"labelMap\"}}\n{{setElement \"labelMap\" \"Draft\" \"Draft\"}}\n{{setElement \"labelMap\" \"Ready\" \"Ready\"}}\n{{setElement \"labelMap\" \"Reviewed\" \"Reviewed\"}}\n{{setElement \"labelMap\" \"Approved\" \"Approved\"}}\n{{setElement \"labelMap\" \"Released\" \"Released\"}}\n\n<!--\n  Create theme map with color for every attribute value. Use any color syntax supported by CSS:\n    - color name: 'lightblue'\n    - hex RGB or RGBA: '#add8e6' or '#add8e6ff'\n    - decimal RGB or RGBA: 'rgb(173, 216, 230)' or 'rgba(173, 216, 230, 1.)'\n    - other syntaxes, see https://developer.mozilla.org/en-US/docs/Web/CSS/named-color\n-->\n{{map \"colorMap\"}}\n{{setElement \"colorMap\" \"Draft\" \"khaki\"}}\n{{setElement \"colorMap\" \"Ready\" \"darkkhaki\"}}\n{{setElement \"colorMap\" \"Reviewed\" \"sandybrown\"}}\n{{setElement \"colorMap\" \"Approved\" \"lightblue\"}}\n{{setElement \"colorMap\" \"Released\" \"lightgreen\"}}\n\n<!-- Iterate all objects in the document 'SRS' and count occurance of attribute value(s). -->\n{{#withDocument \"SRS\" tableView=\"Filter Requirements\"}}\n  {{#eachDocumentObject}}\n    {{incr \"numItems\"}}\n    {{#if [status]}}\n      {{#if (includes \"counterMap\" [status])}}\n        {{setElement \"counterMap\" [status] (eval (getElement \"counterMap\" [status]) \"+\" 1)}}\n      {{/if}}\n    {{/if}}\n  {{/eachDocumentObject}}\n{{/withDocument}}\n\n<!-- Find maximum value for to convert values into normalize range [0..1] in HTML output section. -->\n{{var \"maxValue\" 0}}\n{{#eachOfMap \"counterMap\"}}\n  {{#if (eval @value \">\" (get \"maxValue\"))}}\n    {{set \"maxValue\" @value}}\n  {{/if}}\n{{/eachOfMap}}\n\n<!-- Chart -->\n<div style=\"container-type: size; width: 100%; height: 100%; font-size: 0.9em;\">\n  <table class=\"charts-css show-primary-axis data-outside column data-spacing-4 show-labels\" style=\"min-width: 50px; height: 100%;\">\n    <thead>\n      <tr>\n        <th>Status</th>\n        <th>Count</th>\n      </tr>\n    </thead>\n    <tbody style=\"height: inherit;\">\n{{#eachOfMap \"counterMap\"}}\n      <tr>\n        <th style=\"text-overflow: ellipsis; overflow: hidden; white-space: nowrap;\">{{{getElement \"labelMap\" @key}}}</th>\n        <td style=\"--size: {{eval @value \"/\" (get \"maxValue\")}}; background: {{getElement \"colorMap\" @key}};\">\n          <span class=\"data\" style=\"white-space: nowrap;\">{{@value}}</span>\n          <span class=\"tooltip\">{{@value}} of {{get \"numItems\"}}</span>\n        </td>\n      </tr>\n{{/eachOfMap}}\n    </tbody>\n  </table>\n</div>"
          },
          "TESTS - Overview": {
            "options": {
              "h": 5,
              "locked": false,
              "w": 8,
              "x": 16,
              "y": 4
            },
            "template": "{{var \"numTests\" 0}}\n{{var \"numPassed\" 0}}\n\n<!-- Iterate all objects in the document 'SRS' and count number of verified requirements. -->\n{{#withDocument \"TESTS\"}}\n  {{#eachDocumentObject}}\n    {{#eachColumn}}\n      {{#if (eval (columnId) \"==\" \"type\")}}\n        {{#if (eval type \"==\" \"CASE\")}}\n          {{incr \"numTests\"}}\n          {{#if (eval status \"==\" \"Passed\")}}\n            {{incr \"numPassed\"}}\n          {{/if}}\n        {{/if}}\n      {{/if}}\n    {{/eachColumn}}\n  {{/eachDocumentObject}}\n{{/withDocument}}\n\n<!-- Count number of verified and unverified requirements in percent. -->\n{{var \"numNotPassed\" (eval (get \"numTests\") \"-\" (get \"numPassed\"))}}\n{{var \"percentPassed\" 1}}\n{{var \"percentNotPassed\" 0}}\n{{#if (eval (get \"numTests\") \">\" 0)}}\n  {{set \"percentPassed\" (eval (get \"numPassed\") \"/\" (get \"numTests\"))}}\n  {{set \"percentNotPassed\" (eval (get \"numNotPassed\") \"/\" (get \"numTests\"))}}\n{{/if}}\n{{var \"percentPassed100\" (round (eval (get \"percentPassed\") \"*\" \"100\"))}}\n{{var \"percentNotPassed100\" (round (eval (get \"percentNotPassed\") \"*\" \"100\"))}}\n\n<!-- Counters -->\n<div style=\"display: flex; flex-direction: row; flex-wrap: wrap;\">\n  <div style=\"flex: 1; min-width: 60px; padding: 4px; margin: 4px; position: relative; background-color: #f5f5f5; border: 1px solid #e3e3e3; border-radius: 4px; text-align: center; box-shadow: 3px 3px 3px grey;\">\n    <div style=\"font-size: 1.5rem\">\n      {{get \"numTests\"}}\n    </div>\n    <div style=\"white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 1rem;\">\n      test cases\n    </div>\n  </div>\n  <div style=\"flex: 1; min-width: 60px; padding: 4px; margin: 4px; position: relative; background-color: #f5f5f5; border: 1px solid #e3e3e3; border-radius: 4px; text-align: center; box-shadow: 3px 3px 3px grey;\">\n    <div style=\"font-size: 1.5rem\">\n      {{get \"percentPassed100\"}}%\n    </div> \n    <div style=\"white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 1rem;\">\n      passed\n    </div>\n  </div>\n</div>\n"
          },
          "TESTS - Test Cases by Status": {
            "options": {
              "h": 9,
              "locked": false,
              "w": 8,
              "x": 16,
              "y": 9
            },
            "template": "{{var \"numItems\" 0}}\n\n<!--\n  Create map to count attribute value occurance and init it to 0.\n  Chart will respect the order of the 'setElement' calls below.\n-->\n{{map \"counterMap\"}}\n{{setElement \"counterMap\" \"Draft\" 0}}\n{{setElement \"counterMap\" \"Approved\" 0}}\n{{setElement \"counterMap\" \"Failed\" 0}}\n{{setElement \"counterMap\" \"Passed\" 0}}\n\n<!-- Create map where labels of attribute values will be stored. -->\n{{map \"labelMap\"}}\n{{setElement \"labelMap\" \"Draft\" \"Draft\"}}\n{{setElement \"labelMap\" \"Approved\" \"Approved\"}}\n{{setElement \"labelMap\" \"Failed\" \"Failed\"}}\n{{setElement \"labelMap\" \"Passed\" \"Passed\"}}\n\n<!--\n  Create theme map with color for every attribute value. Use any color syntax supported by CSS:\n    - color name: 'lightblue'\n    - hex RGB or RGBA: '#add8e6' or '#add8e6ff'\n    - decimal RGB or RGBA: 'rgb(173, 216, 230)' or 'rgba(173, 216, 230, 1.)'\n    - other syntaxes, see https://developer.mozilla.org/en-US/docs/Web/CSS/named-color\n-->\n{{map \"colorMap\"}}\n{{setElement \"colorMap\" \"Draft\" \"khaki\"}}\n{{setElement \"colorMap\" \"Approved\" \"lightblue\"}}\n{{setElement \"colorMap\" \"Failed\" \"tomato\"}}\n{{setElement \"colorMap\" \"Passed\" \"lightgreen\"}}\n\n<!-- Iterate all objects in the document 'TESTS' and count occurance of attribute value(s). -->\n{{#withDocument \"TESTS\" tableView=\"Filter Test Cases\"}}\n  {{#eachDocumentObject}}\n    {{incr \"numItems\"}}\n    {{#if [status]}}\n      {{#if (includes \"counterMap\" [status])}}\n        {{setElement \"counterMap\" [status] (eval (getElement \"counterMap\" [status]) \"+\" 1)}}\n      {{/if}}\n    {{/if}}\n  {{/eachDocumentObject}}\n{{/withDocument}}\n\n<!-- Find maximum value for to convert values into normalize range [0..1] in HTML output section. -->\n{{var \"maxValue\" 0}}\n{{#eachOfMap \"counterMap\"}}\n  {{#if (eval @value \">\" (get \"maxValue\"))}}\n    {{set \"maxValue\" @value}}\n  {{/if}}\n{{/eachOfMap}}\n\n<!-- Chart -->\n<div style=\"container-type: size; width: 100%; height: 100%; font-size: 0.9em;\">\n  <table class=\"charts-css show-primary-axis data-outside column data-spacing-4 show-labels\" style=\"min-width: 50px; height: 100%;\">\n    <thead>\n      <tr>\n        <th>Status</th>\n        <th>Count</th>\n      </tr>\n    </thead>\n    <tbody style=\"height: inherit;\">\n{{#eachOfMap \"counterMap\"}}\n      <tr>\n        <th style=\"text-overflow: ellipsis; overflow: hidden; white-space: nowrap;\">{{{getElement \"labelMap\" @key}}}</th>\n        <td style=\"--size: {{eval @value \"/\" (get \"maxValue\")}}; background: {{getElement \"colorMap\" @key}};\">\n          <span class=\"data\" style=\"white-space: nowrap;\">{{@value}}</span>\n          <span class=\"tooltip\">{{@value}} of {{get \"numItems\"}}</span>\n        </td>\n      </tr>\n{{/eachOfMap}}\n    </tbody>\n  </table>\n</div>"
