            },
            {
              "key": "Medium"
            },
            {
              "key": "Low"
            }
          ]
        },
        "soThat": {
          "name": "So that",
          "type": "xhtml"
        },
        "status": {
          "name": "Status",
          "type": "enum",
          "values": [
            {
              "key": "New"
            },
            {
              "key": "Planned"
            },
            {
              "key": "Implemented"
            },
            {
              "key": "Verified"
            }
          ]
        },
        "type": {
          "name": "Type",
          "type": "enum",
          "values": [
            {
              "key": "SEC",
              "label": "Section"
            },
            {
              "key": "INF",
              "label": "Information"
            },
            {
              "key": "EPIC",
              "label": "Epic"
            },
            {
              "key": "STORY",
              "label": "User Story"
            },
            {
              "key": "CON",
              "label": "Constraint"
            }
          ]
        }
      },
      "templateColumns": {
        "0d1271c7-6d97-4500-b709-d8847086d848": {
          "label": "Downstream Traceability",
          "template": "{{#if (eval type \"==\" \"STORY\")}}\n{{#if (hasInlinks \"satisfaction\")}}\n{{#eachInlinkWith type=\"satisfaction\"}}\n  <p>&#x25C2; {{#hyperlink}}{{docObjId}}{{/hyperlink}}: {{shortDescription  maxLength=80}}\n{{#if (hasInlinks \"verification\")}}\n{{#eachInlinkWith type=\"verification\"}}\n    <br>&emsp;&#x25C2; {{#hyperlink}}{{docObjId}}{{/hyperlink}}: {{shortDescription  maxLength=80}}\n{{/eachInlinkWith}}\n{{else}}\n    <br>&emsp;&#x25C2; <em>Missing verification links!</em>\n{{/if}}\n  </p>\n{{/eachInlinkWith}}\n{{else}}\n  <p>&#x25C2; <em>Missing satisfaction links!</em></p>\n{{/if}}\n{{/if}}"
        },
        "dd7d52bc-d0a2-4bfe-99b2-c7daa90ea5a9": {
          "label": "Story",
          "template": "{{#if (eval (eval type \"==\" \"STORY\") \"||\" (eval type \"==\" \"CON\"))}}\n<p>\n<em>As a(n)</em> {{asAn}} <em>I want to</em> {{formatString iWant}} <em>so that</em> {{formatString soThat}}.\n</p>\n{{/if}}"
        }
      },
